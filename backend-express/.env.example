API_PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_visualizer
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Password given to seeded users until they change it (invited users get a random temporary password)
DEFAULT_PASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Invite emails are sent through EmailJS (a link to the login page, never a password); leave these unset to skip sending.
# The private key (EmailJS account > Security) and "Allow EmailJS API for non-browser applications" are needed for server-side calls
# EMAILJS_SERVICE_ID=
# EMAILJS_TEMPLATE_ID=
# EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=

# Folder for uploaded files (rds/ and cover/ are created inside it)
UPLOAD_DIR=/data/uploads
# Largest accepted upload in bytes (default 30 GiB)
# UPLOAD_MAX_BYTES=32212254720

# Internal URL of the Shiny server (never expose it publicly); the /shiny viewer is disabled when unset
SHINY_URL=http://localhost:3838
# Shared with the Shiny app (same SHINY_SECRET there): signs the dataset/access info the app trusts. Use a long random string
SHINY_SECRET=change-me-too
# How long the one-time viewer ticket and the viewer cookie session last
# VIEWER_TICKET_EXPIRES_IN=60s
# VIEWER_SESSION_EXPIRES_IN=1h

# Where the plot data (one Parquet folder per dataset) is kept; defaults to a "parquet" folder next to UPLOAD_DIR's parent
# (so /data/parquet), and the Shiny app must read the same folder
# PARQUET_DIR=/data/parquet
# The preprocessing job runs on this machine, which needs R with Seurat, arrow and Matrix installed.
# PREPROCESS_COMMAND=Rscript
# PREPROCESS_SCRIPT=../shiny/preprocess/preprocess.R
# Kill a job that runs longer than this (default 6 hours)
# PREPROCESS_TIMEOUT_MS=21600000
# Instead of running R on this machine, hand jobs to a worker (the preprocess service in docker-compose.yml) through this shared folder
# PREPROCESS_SPOOL_DIR=/data/jobs
