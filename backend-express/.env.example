PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_visualizer
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Password given to newly invited users until they change it
DEFAULT_PASSWORD=change-me

JWT_SECRET=change-me
JWT_EXPIRES_IN=8h

# Folder for uploaded files (rds/ and cover/ are created inside it)
UPLOAD_DIR=/data/uploads
# Largest accepted upload in bytes (default 30 GiB)
# UPLOAD_MAX_BYTES=32212254720
