{
  "name": "backend-express",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "db:migrate": "node --import tsx node_modules/.bin/sequelize-cli db:migrate --config src/config.ts",
    "db:migrate:undo": "node --import tsx node_modules/.bin/sequelize-cli db:migrate:undo --config src/config.ts",
    "db:seed": "node --import tsx node_modules/.bin/sequelize-cli db:seed:all --config src/config.ts"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
