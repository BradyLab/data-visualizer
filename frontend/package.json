{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "pretest:e2e": "docker compose -f ../docker-compose.e2e.yml down -v && docker compose -f ../docker-compose.e2e.yml up -d --wait",
    "test:e2e": "playwright test",
    "test:e2e:fast": "node e2e/run-local.ts",
    "posttest:e2e": "docker compose -f ../docker-compose.e2e.yml down -v",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/ && prettier --write --experimental-cli ../commons"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.20.0",
    "pinia": "^4.1.0",
    "socket.io-client": "^4.8.4",
    "tus-js-client": "^4.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.89.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "~10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.89.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
