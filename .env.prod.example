# Settings for docker-compose.prod.yml. Copy to .env on the server (cp .env.prod.example .env) and fill in every value without a default.
# Never commit the real .env. Generate each secret with: openssl rand -hex 32

# Public host name of the site (no https://). Its DNS record must point at this server; ports 80 and 443 must be open
DOMAIN=data.example.org

# Database password (the database is not reachable from outside the compose network, but still use a long random one)
POSTGRES_PASSWORD=

# Signs login tokens. At least 32 characters, not a placeholder, and different from SHINY_SECRET: with NODE_ENV=production the backend refuses to start otherwise
JWT_SECRET=
# Signs what the backend tells the Shiny app (shared by both). Same rules as JWT_SECRET
SHINY_SECRET=

# Optional: login token lifetime
# JWT_EXPIRES_IN=8h

# Invite emails through EmailJS (see backend-express/README.md); all four are needed, otherwise no email is sent and the invite dialog says so
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Folder on the server for uploads, plot data and processing jobs (default ./data next to the compose file). It must be writable by uid 1000:
#   sudo chown -R 1000:1000 <folder>
# DATA_DIR=./data

# Memory limit of the preprocessing container: a few GB below the server's RAM, since one large dataset can need 2-5x its file size
# PREPROCESS_MEM_LIMIT=24g

# CPU and memory limits, sized for a server with 32 GB RAM and 4 CPUs (the defaults). The preprocess job should get a core to itself and
# the rest of the memory after the web app, database and Shiny. The Shiny viewer is capped as a whole, and each viewing session's DuckDB
# within it (the sessions together should fit in SHINY_MEM_LIMIT; raise it, or lower SHINY_DUCKDB_MEMORY_LIMIT, if viewers see out-of-memory errors)
# PREPROCESS_CPUS=1
# SHINY_MEM_LIMIT=6g
# SHINY_CPUS=2
# SHINY_DUCKDB_MEMORY_LIMIT=1500MB
# SHINY_DUCKDB_THREADS=2

# Image names and tag (for images built elsewhere, e.g. in CI and pulled from a registry)
# IMAGE_PREFIX=ghcr.io/bradylab/data-visualizer
# IMAGE_TAG=latest
